# Copy to .env and fill in real values. Never commit the real file (it's gitignored).

NODE_ENV=development
PORT=4000
# HOST=0.0.0.0

# Neon Postgres — pooled connection string (used at runtime).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
# Neon Postgres — direct (non-pooled) connection string, used only by `prisma migrate`.
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# Signs the staff session token. Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-real-random-secret-at-least-32-characters-long
# JWT_EXPIRES_IN_MINUTES=480

# Comma-separated origins allowed to call the API directly.
CORS_ORIGIN=http://localhost:3000

# Hop count (or Express's named subnets) to trust for the client's real IP behind a proxy.
# TRUST_PROXY=0

# API_RATE_LIMIT_MAX=300
# LOGIN_RATE_LIMIT_MAX=10
# ENQUIRY_RATE_LIMIT_MAX=10

# Demo staff account created by `npm run db:seed` — defaults shown if left unset.
# SEED_STAFF_EMAIL=staff@shiptrack.com
# SEED_STAFF_PASSWORD=demo1234
